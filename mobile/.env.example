# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* at build time.
# Nothing here is a secret: the relay URL is a hostname and the Cognito
# client id is a public client identifier. Restart the dev server after edits.

# --- Required -------------------------------------------------------
# WebSocket address of your SPARK relay, including the /session path.
# Dev on the same Wi-Fi as your laptop: use the laptop's LAN IP, not
# localhost (localhost on a phone means the phone).
EXPO_PUBLIC_RELAY_URL=ws://192.168.1.20:8787/session

# --- Optional: account sign-in --------------------------------------
# Leave blank to use pairing-code mode (development only).
# These come from the MOBILE Cognito app client - see infra/aws/06-cognito-mobile.sh
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
