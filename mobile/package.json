{
  "name": "spark-mobile",
  "version": "1.0.0",
  "description": "SPARK Mobile — remote session client for the SPARK Engine desktop app",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "fix-deps": "npx expo install --fix",
    "build:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.11",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
